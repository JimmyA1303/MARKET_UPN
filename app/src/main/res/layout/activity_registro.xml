<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/upn_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:background="@drawable/bg_header">

            <View
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-80dp"
                android:layout_marginEnd="-60dp"
                android:background="@drawable/fondo_curva_login" />

            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="-50dp"
                android:layout_marginBottom="-10dp"
                android:background="@drawable/fondo_curva_login" />

            <View
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="32dp"
                android:layout_marginTop="60dp"
                android:alpha="0.7"
                android:background="@drawable/fondo_curva_login" />

            <ImageView
                android:id="@+id/imgLogoRegistro"
                android:layout_width="260dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:layout_marginBottom="25dp"
                android:contentDescription="Logo UPN Market"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_upn_market11" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="-45dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/fondo_login_card"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Crear cuenta"
                android:textColor="@color/upn_azul"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Regístrate como estudiante UPN"
                android:textColor="@color/upn_gris"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:hint="Nombres"
                app:boxBackgroundColor="@color/upn_input"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/upn_amarillo"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="2dp"
                app:startIconDrawable="@drawable/ic_person"
                app:startIconTint="@color/upn_gris">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/upn_azul"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Apellidos"
                app:boxBackgroundColor="@color/upn_input"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/upn_amarillo"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="2dp"
                app:startIconDrawable="@drawable/ic_person"
                app:startIconTint="@color/upn_gris">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApellidos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/upn_azul"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Código de estudiante"
                app:boxBackgroundColor="@color/upn_input"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/upn_amarillo"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="2dp"
                app:startIconDrawable="@drawable/ic_id"
                app:startIconTint="@color/upn_gris"
                app:placeholderText="N00012345">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:textColor="@color/upn_azul"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Correo institucional"
                app:boxBackgroundColor="@color/upn_input"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/upn_amarillo"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="2dp"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="@color/upn_gris"
                app:placeholderText="N00012345@upn.pe">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCorreoRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/upn_azul"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Carrera profesional"
                app:boxBackgroundColor="@color/upn_input"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/upn_amarillo"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="2dp"
                app:startIconDrawable="@drawable/ic_school"
                app:startIconTint="@color/upn_gris"
                android:id="@+id/tilCarrera"
                app:endIconMode="dropdown_menu">

                <AutoCompleteTextView
                    android:id="@+id/autoCarrera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/upn_azul"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Universidad"
                app:boxBackgroundColor="@color/upn_input"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/upn_amarillo"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="2dp"
                app:startIconDrawable="@drawable/ic_school"
                app:startIconTint="@color/upn_gris">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUniversidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="Universidad Privada del Norte"
                    android:textColor="@color/upn_gris"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Contraseña"
                app:boxBackgroundColor="@color/upn_input"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/upn_amarillo"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="2dp"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/upn_gris"
                app:endIconMode="password_toggle"
                app:helperText="Mínimo 6 caracteres">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPasswordRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/upn_azul"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrearCuenta"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="24dp"
                android:text="Crear cuenta"
                android:textAllCaps="false"
                android:textColor="@color/upn_azul"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/upn_amarillo"
                app:cornerRadius="18dp"
                app:elevation="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Ya tienes cuenta?"
                android:textColor="@color/upn_gris"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvIniciarSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text=" Iniciar sesión"
                android:textColor="@color/upn_mostaza"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>